# Contact form (SMTP). Replies go to the sender via Reply-To.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Address that receives contact-form messages.
CONTACT_TO=

# Public site URL, used for canonical links, feeds and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Extra hosts the dev server is reached through (comma-separated).
DEV_ORIGINS=

# Set to 1 to stop logging content changes.
# NEXT_DISABLE_CONTENT_WATCHER=1
